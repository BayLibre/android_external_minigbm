soong_namespace {
    imports: ["device/spacemit/k1/mesa"],
}

cc_library_shared {
    name: "libgbm_mesa_wrapper",
    vendor: true,
    compile_multilib: "64",

    srcs: [
        "gbm_mesa_wrapper.c",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-D_GNU_SOURCE=1",
    ],

    shared_libs: [
        "libcutils",
        "libdrm",
        "libgbm_mesa",
        "liblog",
    ],

    header_libs: [
        "minigbm_headers",
    ],

    export_include_dirs: ["."],
}
